{
  "name": "mineflayer-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing a mineflayer bot to AI agents with a compact 9-tool surface.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mineflayer-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/http.js",
    "test": "node --test --test-concurrency=1 test/world/*.test.js",
    "test:agent": "node --test --test-concurrency=1 test/agent/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mineflayer": "^4.37.0",
    "mineflayer-pathfinder": "^2.4.5",
    "zod": "^3.23.8"
  }
}
