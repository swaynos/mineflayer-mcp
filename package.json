{
  "name": "mineflayer-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing a mineflayer bot to AI agents. 30 tools covering the full casual survival-gameplay loop.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mineflayer-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "smoke": "node scripts/smoke.js",
    "nano:smoke": "node scripts/nano-smoke.js",
    "epoch5:fixture:apply": "node scripts/epoch5-fixture-apply.js",
    "epoch5:fixture:teardown": "node scripts/epoch5-fixture-teardown.js",
    "epoch5:run": "node scripts/epoch5-run.js",
    "epoch5:judge": "node scripts/epoch5-judge.js",
    "epoch5:report": "node scripts/epoch5-report.js",
    "test:epoch5": "node --test test/epoch5.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mineflayer": "^4.37.0",
    "mineflayer-pathfinder": "^2.4.5",
    "zod": "^3.23.8"
  }
}
