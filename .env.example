# mineflayer-mcp environment configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Minecraft server connection
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=mineflayer-bot

# MCP HTTP server
HTTP_PORT=8080
HTTP_PATH=/mcp
HEALTH_PATH=/healthz

# RCON (optional — used by test harness for oracle verification)
# RCON_HOST=localhost
# RCON_PORT=25575
# RCON_PASSWORD=

# Bot behavior
SAFE_MODE=true
LOG_LEVEL=info

# Lockfile path (prevents duplicate bot instances)
LOCK_PATH=/tmp/mineflayer-mcp.lock

# LLM integration (optional)
# OPENAI_API_KEY=
# NGROK_AUTH_TOKEN=
