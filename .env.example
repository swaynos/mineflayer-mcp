# mineflayer-mcp environment configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Minecraft server connection
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=mineflayer-bot
MC_VERSION=1.21.1

# MCP HTTP server
HTTP_PORT=8080
HTTP_PATH=/mcp
HEALTH_PATH=/healthz

# RCON (project-owned Docker stack — required for npm test)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=mineflayer-dev

# Bot behavior
SAFE_MODE=true
LOG_LEVEL=info

# Lockfile path (prevents duplicate bot instances)
LOCK_PATH=/tmp/mineflayer-mcp.lock

# Agent test layer (npm run test:agent)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# AGENT_MCP_URL=http://127.0.0.1:8080/mcp
# AGENT_MODEL=gpt-4o-mini
# AGENT_BOT_NAME=agent-test-bot

# Session-soak configuration (optional overrides)
# AGENT_SOAK_TASKS=20
# AGENT_SOAK_PASS_PCT=85
# AGENT_SOAK_P95_MS=10000
